<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tesseract_nanobind</name>
  <version>0.35.0.7</version>
  <description>
    Tesseract robotics Python bindings built with nanobind. Designed to be built
    with colcon against the same tesseract C++ libraries the rest of the ROS
    workspace (e.g. MoveIt) links, so only one copy of each libtesseract_*.so is
    loaded in a process.
  </description>
  <maintainer email="wason@wasontech.com">John Wason</maintainer>
  <maintainer email="jelle@terrestrial.construction">Jelle Feringa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend condition="$ROS_VERSION == 2">cmake</buildtool_depend>

  <!-- tesseract C++ libraries (must be built/installed in the same workspace,
       so the bindings link the exact same sonames as MoveIt) -->
  <depend>tesseract</depend>
  <depend>tesseract_planning</depend>
  <build_depend>python3-nanobind</build_depend>

  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-numpy</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-yaml</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-scipy</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-loguru</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ament_index_python</exec_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
